# Python bytecode caches (recreated automatically, never worth committing)
__pycache__/
*.py[cod]
.pytest_cache/

# Local virtual environment (each machine builds its own from requirements.txt)
.venv/
venv/

# Datasets: tens of gigabytes, and the licences forbid redistributing them.
# NOTE: we must NOT ignore `data/` itself, because that folder is our Python
# package (data/eyepacs.py etc.). Images live under `datasets/` instead.
datasets/
*.jpeg
*.jpg
*.tif
*.tiff

# Training outputs: checkpoints, CSV logs, metric JSON files
outputs/
checkpoints/
*.pt
*.pth
*.ckpt

# Report figures are regenerated by `python -m eval.plots`; keep only the folder
report/figures/*
!report/figures/.gitkeep

# LaTeX build by-products
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/main.pdf

# Personal study guide: must never be committed (see the warning inside it)
READING_ORDER_DELETE_BEFORE_PUSH.md

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
